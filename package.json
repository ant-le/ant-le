{
    "name": "website",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --silent && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run src",
        "test:e2e": "npm run build && playwright test",
        "validate": "npm run format:check && npm run lint && npm run check && npm run test:unit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inlang/paraglide-js": "^2.21.0",
        "@inlang/plugin-m-function-matcher": "^2.2.9",
        "@inlang/plugin-message-format": "^4.4.0",
        "@playwright/test": "^1.61.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.57.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.2",
        "@types/node": "^25.9.1",
        "eslint": "^10.7.0",
        "eslint-plugin-svelte": "^3.20.0",
        "globals": "^17.7.0",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.6",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.0.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "ipaddr.js": "^2.5.0",
        "postgres": "^3.4.9"
    }
}
